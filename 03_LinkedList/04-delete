class Node:
    def __init__(self, data):
        self.data = data
        self.next = None

#Create Linked list
first = Node(10)
second = Node(20)
third = Node(30)

#Linke the Node together
first.next = second
second.next = third

target = 20

previous = None
current = first

while current is not None:
    if current.data == target:
        previous.next = current.next
        break

    previous = current
    current = current.next 